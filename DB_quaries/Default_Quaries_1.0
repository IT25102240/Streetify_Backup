--To view only Drivers: 
SELECT * FROM users WHERE dtype = 'DRIVER';

--To view only Passengers: 
SELECT * FROM users WHERE dtype = 'USER';

--To view only Admins:
SELECT * FROM users WHERE role = 'ADMIN';

